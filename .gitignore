# ======================================================
# IntelliSpend — .gitignore
# ======================================================

# ============================
# Environment & Secrets (NEVER commit)
# ============================
.env
.env.local
.env.production
*.env

# ============================
# Node / Angular
# ============================
node_modules/
dist/
.angular/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# ============================
# Java / Maven / Spring Boot
# ============================
target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Maven wrapper
.mvn/
mvnw
mvnw.cmd

# ============================
# Python / ML Service
# ============================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
.venv/
.env/
ENV/

# Jupyter Notebooks
.ipynb_checkpoints

# ML Models (saved models can be large — optionally track with Git LFS)
app/models/saved/*.joblib
ml-service/anomaly-detection/app/models/saved/*.joblib

# ============================
# IDE / Editor
# ============================
.idea/
*.iml
*.ipr
*.iws
.vscode/settings.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# ============================
# Docker
# ============================
.dockerignore

# ============================
# Logs
# ============================
logs/
*.log
log/

# ============================
# OS
# ============================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# ============================
# Uploads / Receipts (local dev artifacts)
# ============================
uploads/
receipts/

# ============================
# Coverage / Test reports
# ============================
coverage/
*.lcov
.nyc_output
htmlcov/
.coverage
.pytest_cache/
surefire-reports/
