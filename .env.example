# ======================================================
# IntelliSpend — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ======================================================

# ============================
# Database Configuration
# ============================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=intellispend_db
DB_USERNAME=intellispend_user
DB_PASSWORD=your_strong_db_password_here
DB_ROOT_PASSWORD=your_strong_root_password_here

# ============================
# JWT Configuration
# IMPORTANT: Use a cryptographically random 256-bit+ secret
# Generate with: openssl rand -base64 64
# ============================
JWT_SECRET=replace_with_a_very_long_random_secret_key_at_least_256_bits_long
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000

# ============================
# ML Service
# ============================
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=10000

# ============================
# CORS
# ============================
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ============================
# Server
# ============================
SERVER_PORT=8080

# ============================
# Angular Frontend
# (Set these in environment.ts for local, or as build args for Docker)
# ============================
ANGULAR_API_URL=http://localhost:8080/api
ANGULAR_ML_URL=http://localhost:8000

# ============================
# Cloud Deployment (fill when deploying)
# ============================
# FRONTEND_URL=https://intellispend.vercel.app
# BACKEND_URL=https://intellispend-api.railway.app
# ML_SERVICE_PROD_URL=https://intellispend-ml.railway.app
